{
  "name": "cabaret",
  "displayName": "Cabaret",
  "version": "0.0.0",
  "private": true,
  "description": "Diff-based in-editor code review",
  "categories": [
    "Other"
  ],
  "publisher": "cabaret",
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --loader:.node=copy --asset-names=[name] --sourcemap --outfile=out/extension.js",
    "typecheck": "tsc --noEmit",
    "test:integration": "rm -rf out/test && esbuild test/*.test.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outdir=out/test && vscode-test",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o cabaret.vsix",
    "test:navigation": "node --test test/navigation.node.mjs"
  },
  "dependencies": {
    "@cabaret/node": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "catalog:",
    "@vscode/test-electron": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  },
  "contributes": {
    "languages": [
      {
        "id": "cabaret",
        "aliases": [
          "Cabaret"
        ]
      }
    ],
    "configurationDefaults": {
      "[cabaret]": {
        "editor.lineHeight": 1.2
      }
    },
    "commands": [
      {
        "command": "cabaret.selectRepository",
        "title": "Cabaret: Open Worktree"
      },
      {
        "command": "cabaret.home",
        "title": "Cabaret: Home"
      },
      {
        "command": "cabaret.showChange",
        "title": "Cabaret: Show Change"
      },
      {
        "command": "cabaret.diff",
        "title": "Cabaret: Diff"
      },
      {
        "command": "cabaret.review",
        "title": "Cabaret: Review"
      },
      {
        "command": "cabaret.workspaceDiff",
        "title": "Cabaret: Workspace Diff"
      },
      {
        "command": "cabaret.commitAll",
        "title": "Cabaret: Commit All"
      },
      {
        "command": "cabaret.commitSelected",
        "title": "Cabaret: Commit Selected"
      },
      {
        "command": "cabaret.discardSelected",
        "title": "Cabaret: Discard Selected"
      },
      {
        "command": "cabaret.refresh",
        "title": "Cabaret: Refresh"
      },
      {
        "command": "cabaret.mark",
        "title": "Cabaret: Mark Reviewed",
        "icon": "$(check)"
      },
      {
        "command": "cabaret.startSession",
        "title": "Cabaret: Start Session"
      },
      {
        "command": "cabaret.stepIn",
        "title": "Cabaret: Step In"
      },
      {
        "command": "cabaret.stepOut",
        "title": "Cabaret: Step Out"
      },
      {
        "command": "cabaret.stepUp",
        "title": "Cabaret: Step Up"
      },
      {
        "command": "cabaret.stepDown",
        "title": "Cabaret: Step Down"
      },
      {
        "command": "cabaret.createChild",
        "title": "Cabaret: Create Child"
      },
      {
        "command": "cabaret.createParent",
        "title": "Cabaret: Create Parent"
      },
      {
        "command": "cabaret.addOwner",
        "title": "Cabaret: Add Owner"
      },
      {
        "command": "cabaret.removeOwner",
        "title": "Cabaret: Remove Owner"
      },
      {
        "command": "cabaret.addParent",
        "title": "Cabaret: Add Parent"
      },
      {
        "command": "cabaret.removeParent",
        "title": "Cabaret: Remove Parent"
      },
      {
        "command": "cabaret.land",
        "title": "Cabaret: Land"
      },
      {
        "command": "cabaret.rebase",
        "title": "Cabaret: Rebase"
      },
      {
        "command": "cabaret.toggleArchived",
        "title": "Cabaret: Toggle Archived"
      },
      {
        "command": "cabaret.createWorkspace",
        "title": "Cabaret: Create Workspace"
      },
      {
        "command": "cabaret.deleteWorkspace",
        "title": "Cabaret: Delete Workspace"
      },
      {
        "command": "cabaret.gotoWorkspace",
        "title": "Cabaret: Go to Workspace"
      },
      {
        "command": "cabaret.editTitle",
        "title": "Cabaret: Edit Title"
      },
      {
        "command": "cabaret.editDescription",
        "title": "Cabaret: Edit Description"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cabaret.mark",
          "when": "resourceScheme == 'cabaret-blob' && cabaret.view != 'workspace'",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cabaret.diff",
        "key": "d",
        "when": "editorTextFocus && (cabaret.page == 'home' || cabaret.page == 'show' || cabaret.page == 'review' || cabaret.page == 'workspace' || (cabaret.page == 'file' && cabaret.view == 'review')) && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.review",
        "key": "r",
        "when": "editorTextFocus && (cabaret.page == 'home' || cabaret.page == 'show' || cabaret.page == 'diff' || cabaret.page == 'workspace' || (cabaret.page == 'file' && cabaret.view == 'diff')) && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.workspaceDiff",
        "key": "w",
        "when": "editorTextFocus && (cabaret.page == 'home' || cabaret.page == 'show' || cabaret.page == 'diff' || cabaret.page == 'review') && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.commitAll",
        "key": "shift+1 shift+c",
        "when": "editorTextFocus && cabaret.page == 'workspace' && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.commitSelected",
        "key": "shift+1 c",
        "when": "editorTextFocus && cabaret.page == 'workspace' && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.discardSelected",
        "key": "shift+1 - c",
        "when": "editorTextFocus && cabaret.page == 'workspace' && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.mark",
        "key": "shift+1 m",
        "when": "editorTextFocus && (cabaret.page == 'diff' || cabaret.page == 'review') && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.mark",
        "key": "shift+1 m",
        "when": "editorTextFocus && cabaret.page == 'file' && cabaret.view != 'workspace' && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.startSession",
        "key": "shift+a",
        "when": "editorTextFocus && (cabaret.page == 'home' || cabaret.page == 'show') && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.refresh",
        "key": "shift+r",
        "when": "editorTextFocus && (cabaret.page == 'home' || cabaret.page == 'show' || cabaret.page == 'diff' || cabaret.page == 'review' || cabaret.page == 'workspace') && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "q",
        "when": "editorTextFocus && cabaret.page && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepIn",
        "key": "enter",
        "when": "editorTextFocus && cabaret.page && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepIn",
        "key": "enter",
        "when": "editorTextFocus && (cabaret.page == 'diff' || cabaret.page == 'review' || cabaret.page == 'workspace') && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "editor.toggleFold",
        "key": "tab",
        "when": "editorTextFocus && (cabaret.page == 'home' || cabaret.page == 'show' || cabaret.page == 'diff' || cabaret.page == 'review') && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepOut",
        "key": "escape",
        "when": "editorTextFocus && (cabaret.page == 'show' || cabaret.page == 'diff' || cabaret.page == 'review' || cabaret.page == 'workspace' || cabaret.page == 'file') && !editorHasSelection && !editorHasMultipleSelections && !findWidgetVisible && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepUp",
        "key": "shift+6",
        "when": "editorTextFocus && cabaret.page && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepDown",
        "key": "shift+4",
        "when": "editorTextFocus && cabaret.page && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.createChild",
        "key": "shift+1 c",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.createParent",
        "key": "shift+1 p c",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.addOwner",
        "key": "shift+1 o a",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.removeOwner",
        "key": "shift+1 o r",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.addParent",
        "key": "shift+1 p a",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.removeParent",
        "key": "shift+1 p r",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.land",
        "key": "shift+1 l",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.land",
        "key": "shift+1 l",
        "when": "editorTextFocus && cabaret.page == 'home' && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.rebase",
        "key": "shift+1 r",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.rebase",
        "key": "shift+1 r",
        "when": "editorTextFocus && cabaret.page == 'home' && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.toggleArchived",
        "key": "shift+1 a",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.toggleArchived",
        "key": "shift+1 a",
        "when": "editorTextFocus && cabaret.page == 'home' && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.createWorkspace",
        "key": "shift+1 w c",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.createWorkspace",
        "key": "shift+1 w c",
        "when": "editorTextFocus && cabaret.page == 'home' && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.deleteWorkspace",
        "key": "shift+1 w d",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.deleteWorkspace",
        "key": "shift+1 w d",
        "when": "editorTextFocus && cabaret.page == 'home' && (!vim.active || vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "command": "cabaret.gotoWorkspace",
        "key": "shift+1 w g",
        "when": "editorTextFocus && cabaret.actsOnChange && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.editTitle",
        "key": "shift+1 t",
        "when": "editorTextFocus && cabaret.page == 'show' && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.editDescription",
        "key": "shift+1 d",
        "when": "editorTextFocus && cabaret.page == 'show' && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      }
    ],
    "configuration": {
      "title": "Cabaret",
      "properties": {
        "cabaret.sessionArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--permission-mode",
            "auto",
            "--permission-prompts",
            "none"
          ],
          "markdownDescription": "Arguments for `claude --print` when starting a session on a change, ahead of the prompt. Nobody is there to answer a permission prompt, so the default lets Claude Code's auto mode decide and tells it not to ask at all (`--permission-prompts` needs Claude Code 2.1.259 or later)."
        },
        "leaderkey.overrides._cabaret": {
          "type": "object",
          "description": "Bindings contributed to the leaderkey extension, active when it is installed",
          "default": {
            "SPC a": "+Applications",
            "SPC a f": "+Cabaret",
            "SPC a h": {
              "name": "Workspace diff",
              "command": "cabaret.workspaceDiff"
            },
            "SPC a f t": {
              "name": "Home",
              "command": "cabaret.home"
            },
            "SPC a f s": {
              "name": "Show change",
              "command": "cabaret.showChange"
            }
          }
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.125.0"
  }
}
